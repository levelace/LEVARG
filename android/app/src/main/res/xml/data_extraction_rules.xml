<?xml version="1.0" encoding="utf-8"?>
<!-- Data extraction rules for Android 12+ (cloud backup & device transfer) -->
<data-extraction-rules>
    <cloud-backup>
        <!-- Only back up the database; exclude credentials and browser profiles -->
        <include domain="database" path="." />
        <exclude domain="cache" path="." />
        <exclude domain="external" path="." />
    </cloud-backup>
    <device-transfer>
        <include domain="database" path="." />
        <include domain="sharedpref" path="." />
        <exclude domain="cache" path="." />
    </device-transfer>
</data-extraction-rules>
