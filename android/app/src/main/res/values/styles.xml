<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- Base application theme — dark to match LevarG UI -->
    <style name="AppTheme" parent="Theme.AppCompat.NoActionBar">
        <item name="colorPrimary">#050505</item>
        <item name="colorPrimaryDark">#050505</item>
        <item name="colorAccent">#10b981</item>
        <item name="android:windowBackground">#050505</item>
        <item name="android:navigationBarColor">#050505</item>
        <item name="android:statusBarColor">#050505</item>
    </style>

    <style name="AppTheme.NoActionBar" parent="Theme.AppCompat.NoActionBar">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
        <item name="android:background">@null</item>
        <item name="android:navigationBarColor">#050505</item>
        <item name="android:statusBarColor">#050505</item>
    </style>

    <style name="AppTheme.NoActionBarLaunch" parent="Theme.SplashScreen">
        <item name="android:background">@drawable/splash</item>
    </style>
</resources>
